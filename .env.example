# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your real email stays out of the repo.

# Sent in the User-Agent header so Open Library can contact you about your
# app's traffic: https://openlibrary.org/developers/api
CONTACT_EMAIL=you@example.com

# Optional. Django uses a development-only key when this is not set.
# DJANGO_SECRET_KEY=change-me
